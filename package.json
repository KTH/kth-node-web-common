{
  "name": "@kth/kth-node-web-common",
  "version": "11.0.0",
  "description": "Common components for node-web projects",
  "scripts": {
    "lint": "eslint --quiet",
    "lint-v": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "echo \"No build step required\"",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KTH/kth-node-web-common.git"
  },
  "keywords": [
    "kth",
    "nodejs",
    "web"
  ],
  "author": {
    "name": "KTH",
    "email": "infosys@kth.se",
    "url": "https://github.com/KTH"
  },
  "license": "MIT",
  "files": [
    "lib/error.js",
    "lib/errorTemplate.handlebars",
    "lib/language.js",
    "lib/i18n/**",
    "lib/web/**",
    "lib/handlebars/helpers/breadcrumbs.js",
    "lib/handlebars/helpers/conditionalLogotypeSrc.js",
    "lib/handlebars/helpers/createI18nHelper.js",
    "lib/handlebars/helpers/headerContent.js",
    "lib/handlebars/helpers/languageLink.js",
    "lib/handlebars/pages/**/*.handlebars",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://github.com/KTH/kth-node-web-common/issues"
  },
  "homepage": "https://github.com/KTH/kth-node-web-common#readme",
  "dependencies": {
    "@kth/log": "^4.0.8",
    "handlebars": "^4.7.10",
    "locale": "^0.1.0"
  },
  "peerDependencies": {
    "kth-node-i18n": ">=2.0.1 <3"
  },
  "devDependencies": {
    "@kth/eslint-config-kth": "^4.1.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "kth-node-i18n": "^2.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "// (jest)": "configuration version 2020-06-15 (API+NPM) - might also reside as module.exports in jest.config.js",
  "jest": {
    "clearMocks": true,
    "notifyMode": "failure-change",
    "testEnvironment": "node",
    "verbose": true
  }
}
