  },
  "keywords": [
    "kth",
    "nodejs",
    "web"
  ],
  "author": {
    "name": "KTH",
    "email": "infosys@kth.se",
    "url": "https://github.com/KTH"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/KTH/kth-node-web-common/issues"
  },
  "homepage": "https://github.com/KTH/kth-node-web-common#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@kth/log": "^4.0.8",
    "handlebars": "^4.7.9",
    "kth-node-i18n": "^1.0.18",
    "locale": "^0.1.0"
  },
  "devDependencies": {
    "@kth/eslint-config-kth": "^3.7.0",
